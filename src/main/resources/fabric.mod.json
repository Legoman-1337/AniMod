{
	"schemaVersion": 1,
	"id": "animod",
	"version": "${version}",
	"name": "AniMod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/animod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.legoman.animod.AniMod"
		],
		"client": [
			"net.legoman.animod.client.AniModClient"
		]
	},
	"mixins": [
		"animod.mixins.json",
		{
			"config": "animod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}